{
  "mcpServers": {
    "sniper-triage": {
      "command": "/ABSOLUTE/PATH/TO/sniper/.venv/bin/python",
      "args": [
        "/ABSOLUTE/PATH/TO/sniper/scripts/sniper-mcp",
        "--mode",
        "authenticated",
        "--db",
        "/ABSOLUTE/PATH/TO/sniper.db",
        "--token-file",
        "/ABSOLUTE/PATH/TO/private/mcp-token"
      ]
    }
  }
}
