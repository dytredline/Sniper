{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Service up",
      "id": 1,
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"sniper\"}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "id": 2,
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "targets": [{"expr": "sum by (status) (rate(sniper_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Response time p95",
      "id": 3,
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(sniper_http_request_duration_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Active scans",
      "id": 4,
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "targets": [{"expr": "sniper_scans_active", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Loaded plugins",
      "id": 5,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "targets": [{"expr": "sniper_plugins_loaded", "refId": "A"}]
    }
  ],
  "schemaVersion": 39,
  "tags": ["sniper", "local"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Sniper local health",
  "uid": "sniper-local",
  "version": 1
}
