#!/usr/bin/env python3
"""Create a rootless Sniper Community environment and install the locked local tool profile."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


APP_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(APP_ROOT))

from community_setup import SetupError, setup_community  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--venv-dir", type=Path, default=Path(".venv"))
    parser.add_argument("--install-dir", type=Path, default=Path("runtimes"))
    parser.add_argument("--wheelhouse", type=Path)
    parser.add_argument("--tool-cache-dir", type=Path)
    parser.add_argument(
        "--accept-third-party-licenses",
        action="store_true",
        help="confirm review and acceptance of licenses in COMMUNITY-TOOLS.lock.json",
    )
    args = parser.parse_args(argv)
    try:
        result = setup_community(
            APP_ROOT,
            venv_dir=args.venv_dir,
            install_dir=args.install_dir,
            cache_dir=args.tool_cache_dir,
            wheelhouse=args.wheelhouse,
            accept_third_party_licenses=args.accept_third_party_licenses,
        )
    except SetupError as exc:
        print(f"community setup: FAIL ({exc})", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
