#!/usr/bin/env python3
"""Install SHA-256 locked, redistributable local Community tool runtimes."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


APP_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(APP_ROOT))

from community_tool_installer import InstallError, install_profile  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", default="local", choices=("local",))
    parser.add_argument("--install-dir", type=Path, default=APP_ROOT / "runtimes")
    parser.add_argument("--cache-dir", type=Path)
    parser.add_argument("--platform", dest="platform_key")
    parser.add_argument(
        "--accept-third-party-licenses",
        action="store_true",
        help="confirm review and acceptance of the licenses listed in COMMUNITY-TOOLS.lock.json",
    )
    args = parser.parse_args(argv)
    try:
        report = install_profile(
            APP_ROOT / "COMMUNITY-TOOLS.lock.json",
            args.install_dir,
            profile=args.profile,
            platform_key=args.platform_key,
            cache_dir=args.cache_dir,
            accept_licenses=args.accept_third_party_licenses,
        )
    except InstallError as exc:
        print(f"community tool install: FAIL ({exc})", file=sys.stderr)
        return 1
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
