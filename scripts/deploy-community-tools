#!/usr/bin/env python3
"""Build and start the five-engine loopback-only Community Docker profile."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import time
from urllib.error import URLError
from urllib.request import urlopen


ROOT = Path(__file__).resolve().parents[1]
COMPOSE = ["docker", "compose", "-f", "docker-compose.yml", "-f", "docker-compose.tools.yml"]
HEALTH_URL = "http://127.0.0.1:8787/api/health"
READINESS_URL = "http://127.0.0.1:8787/api/tooling/readiness"
REQUIRED_PROFILES = {
    "nuclei": "/api/tool-runs/nuclei-loopback",
    "trivy": "/api/tool-runs/trivy-secret",
    "gitleaks": "/api/tool-runs/gitleaks",
    "trufflehog": "/api/tool-runs/trufflehog-filesystem",
    "semgrep": "/api/tool-runs/semgrep",  # This local profile runs the pinned Opengrep binary.
}


def _fetch_json(url: str) -> dict:
    with urlopen(url, timeout=3) as response:
        if response.status != 200:
            raise ValueError(f"HTTP {response.status}")
        payload = json.load(response)
    if not isinstance(payload, dict):
        raise ValueError("Invalid Sniper response")
    return payload


def missing_engines(readiness: dict) -> list[str]:
    profiles = {
        tool.get("id"): tool.get("profiles")
        for tool in readiness.get("tools", [])
        if isinstance(tool, dict)
    }
    missing = []
    for engine, route in REQUIRED_PROFILES.items():
        rows = profiles.get(engine)
        if not isinstance(rows, list) or not any(
            isinstance(row, dict)
            and row.get("route") == route
            and row.get("runtime") == "precheck_passed"
            for row in rows
        ):
            missing.append("opengrep" if engine == "semgrep" else engine)
    return missing


def ensure_local_env() -> None:
    """Create the existing deployment's local Grafana secret without replacing it."""
    path = ROOT / ".env"
    if path.is_symlink():
        raise ValueError(".env sembolik bağ olamaz")
    if path.exists():
        if not path.is_file():
            raise ValueError(".env normal bir dosya olmalı")
        return
    secret = secrets.token_urlsafe(24)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        return  # Another local setup created the file; never overwrite it.
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.write(f"GRAFANA_ADMIN_PASSWORD={secret}\n")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--accept-third-party-licenses", action="store_true")
    args = parser.parse_args(argv)
    if not args.accept_third_party_licenses:
        print("Beş motorun ayrı lisanslarını kabul etmek için --accept-third-party-licenses gerekli.", file=sys.stderr)
        return 2

    env = dict(os.environ)
    env["SNIPER_ACCEPT_THIRD_PARTY_LICENSES"] = "1"
    try:
        subprocess.run(["docker", "info"], cwd=ROOT, env=env, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        ensure_local_env()
        subprocess.run([sys.executable, str(ROOT / "scripts/build-community-tools-image"),
                        "--accept-third-party-licenses"], cwd=ROOT, env=env, check=True)
        subprocess.run([*COMPOSE, "up", "-d", "--no-build", "sniper"],
                       cwd=ROOT, env=env, check=True)
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"Docker kurulumu başlatılamadı: {exc}", file=sys.stderr)
        return 1

    deadline = time.monotonic() + 90
    last_error = "Sniper henüz hazır değil"
    while time.monotonic() < deadline:
        try:
            health = _fetch_json(HEALTH_URL)
            readiness = _fetch_json(READINESS_URL)
            if health.get("status") == "ok":
                missing = missing_engines(readiness)
                if not missing:
                    print("Sniper Docker hazır: http://127.0.0.1:8787")
                    print("Beş motor hazır: Nuclei, Trivy, Gitleaks, TruffleHog, Opengrep")
                    return 0
                last_error = "Hazır olmayan motorlar: " + ", ".join(missing)
        except (OSError, URLError, ValueError, json.JSONDecodeError) as exc:
            last_error = str(exc)
        time.sleep(2)
    print(f"Sniper hazır olma denetimi başarısız: {last_error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
